# Local environment and credentials
.env
.env.*
!.env.example
!.env.*.example
!.env.encrypted
!.env.*.encrypted
/auth.json
/.aws/

# Composer and Node dependencies (keep composer.lock and package lockfiles)
/vendor/
/node_modules/

# Compiled frontend assets and development-server files
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/bootstrap/ssr/

# Laravel runtime files; nested .gitignore files preserve storage/cache directories
*.log
/storage/*.key
/storage/pail/
/storage/clockwork/
/storage/debugbar/
/database/*.sqlite*

# Test, coverage, and analysis caches
/.phpunit.cache/
/.phpunit.result.cache
/.pest/
/.phpactor.json
/.phpactor.yml
/.php-cs-fixer.cache
/.phpstan.cache/
/.phpstan-result-cache.php
/.phpunit-watcher.yml
/coverage/
/coverage.xml
/clover.xml
/.nyc_output/

# Generated IDE helpers
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php

# Local editor and assistant settings
/.codex/
/.cursor/
/.idea/
/.nova/
/.vscode/
/.zed/
/.claude/settings.local.json

# Local virtual-machine configuration
/Homestead.json
/Homestead.yaml
/.vagrant/

# Python caches generated by genealogy extraction scripts
__pycache__/
*.py[cod]

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
