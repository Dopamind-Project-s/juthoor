# Preferred deployment: configure the domain document root as <project>/public.
# Fallback for Hostinger plans serving the complete project from public_html.
Options -Indexes -MultiViews
DirectoryIndex index.php

# Never serve dotfiles, credentials, logs or backup copies from either layout.
<FilesMatch "(?i)(^\.|^error_log$|\.(?:log|sql|sqlite|sqlite3|bak|backup|old|orig|save|swp)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Laravel authentication and CSRF headers across internal rewrites.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-XSRF-Token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Remove /public only from URLs actually requested by the client.
    # Internal rewrites must not trigger this redirect.
    RewriteCond %{THE_REQUEST} \s/+public(?:[/\s?]) [NC]
    RewriteRule ^public(?:/public)*(?:/(.*))?$ /$1 [R=308,L]

    # Only the public subtree may be served; existing project files get no bypass.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    # public/vendor contains the application's intentionally published CSS/JS.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
